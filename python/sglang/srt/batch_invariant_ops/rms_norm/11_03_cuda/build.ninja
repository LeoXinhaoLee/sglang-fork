ninja_required_version = 1.3
cxx = /root/miniconda/envs/sglang_fork/bin/x86_64-conda-linux-gnu-c++
nvcc = /root/miniconda/envs/sglang_fork/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=batch_invariant_rmsnorm -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/root/cutlass/include -isystem /root/miniconda/envs/sglang_fork/lib/python3.11/site-packages/torch/include -isystem /root/miniconda/envs/sglang_fork/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /root/miniconda/envs/sglang_fork/include -isystem /root/miniconda/envs/sglang_fork/include/python3.11 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -ccbin /root/miniconda/envs/sglang_fork/bin/x86_64-conda-linux-gnu-cc -DTORCH_EXTENSION_NAME=batch_invariant_rmsnorm -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/root/cutlass/include -isystem /root/miniconda/envs/sglang_fork/lib/python3.11/site-packages/torch/include -isystem /root/miniconda/envs/sglang_fork/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /root/miniconda/envs/sglang_fork/include -isystem /root/miniconda/envs/sglang_fork/include/python3.11 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 --use_fast_math -gencode=arch=compute_90,code=sm_90 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/root/miniconda/envs/sglang_fork/lib/python3.11/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/root/miniconda/envs/sglang_fork/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build main.o: compile /root/sglang-fork/python/sglang/srt/batch_invariant_ops/rms_norm/11_03_cuda/main.cpp
build cuda.cuda.o: cuda_compile /root/sglang-fork/python/sglang/srt/batch_invariant_ops/rms_norm/11_03_cuda/cuda.cu





build batch_invariant_rmsnorm.so: link main.o cuda.cuda.o

default batch_invariant_rmsnorm.so
